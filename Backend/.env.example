# =============================================================================
# EnglishBrain Backend · variables de entorno
# Copia este archivo como .env y rellénalo. El archivo .env NUNCA se sube
# a ningún repositorio (está en .gitignore).
# =============================================================================

# URL del proyecto de Supabase (Settings → Data API → Project URL)
SUPABASE_URL=https://ujipnxeaipreyjcnoean.supabase.co

# Secret key de Supabase (Settings → API Keys → Secret keys). Empieza por sb_secret_
# ⚠️ Da acceso total a la base de datos: solo va aquí, nunca en el Frontend ni en la extensión.
SUPABASE_SECRET_KEY=

# Orígenes que pueden llamar a la API (el Frontend), separados por coma
CORS_ORIGINS=http://localhost:5173

# Puerto de la API (opcional, por defecto 3000)
PORT=3000
