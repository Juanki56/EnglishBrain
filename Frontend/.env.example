# =============================================================================
# EnglishBrain Frontend · variables de entorno
# Copia este archivo como .env y rellénalo. Todo lo que empieza por VITE_ llega
# al navegador: aquí NUNCA va la secret key de Supabase.
# =============================================================================

# Dirección del Backend
VITE_API_URL=http://localhost:3000

# Supabase (solo para registro, login y recuperación de contraseña)
VITE_SUPABASE_URL=https://ujipnxeaipreyjcnoean.supabase.co
# Settings → API Keys → Publishable key (empieza por sb_publishable_)
VITE_SUPABASE_PUBLISHABLE_KEY=
