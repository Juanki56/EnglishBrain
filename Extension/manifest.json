{
  "manifest_version": 3,
  "name": "EnglishBrain",
  "version": "0.1.0",
  "description": "Envía a tu Cerebro de Inglés la palabra que seleccionas y su párrafo de contexto, sin dejar de leer.",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "capture-selection": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Enviar la selección a mi Cerebro de Inglés"
    }
  },
  "action": {
    "default_title": "EnglishBrain · selecciona una palabra y pulsa Alt+S",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
